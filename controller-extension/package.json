{
  "name": "adagio-agent-controller",
  "displayName": "Adagio Agent Controller",
  "description": "VS Code extension that connects Copilot to a Windows VM agent for automated installer testing",
  "version": "0.1.0",
  "publisher": "adagio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adagioAgent.runInstaller",
        "title": "Adagio Agent: Run Installer in VM"
      },
      {
        "command": "adagioAgent.getUiTree",
        "title": "Adagio Agent: Get UI Tree"
      },
      {
        "command": "adagioAgent.clickElement",
        "title": "Adagio Agent: Click Element"
      },
      {
        "command": "adagioAgent.getScreenshot",
        "title": "Adagio Agent: Get Screenshot"
      },
      {
        "command": "adagioAgent.typeText",
        "title": "Adagio Agent: Type Text"
      }
    ],
    "configuration": {
      "title": "Adagio Agent",
      "properties": {
        "adagioAgent.vmAgentUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "Base URL of the VM agent (e.g. http://192.168.1.100:5000)"
        },
        "adagioAgent.allowedInstallerPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "C:\\Installers"
          ],
          "description": "Allowed installer directories (command whitelist)"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "adagioAgent_runInstaller",
        "displayName": "Run Installer in VM",
        "modelDescription": "Start an installer executable inside the Windows VM and return its process ID.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "Full path to the installer executable on the VM, e.g. C:\\Installers\\MyAppSetup.exe"
            },
            "arguments": {
              "type": "string",
              "description": "Optional command-line arguments to pass to the installer"
            },
            "workingDirectory": {
              "type": "string",
              "description": "Optional working directory for the process"
            }
          },
          "required": [
            "command"
          ]
        }
      },
      {
        "name": "adagioAgent_getUiTree",
        "displayName": "Get UI Tree",
        "modelDescription": "Return the UI element hierarchy of the installer window so Copilot can reason about which buttons or controls exist.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runInstaller"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_getScreenshot",
        "displayName": "Get Screenshot",
        "modelDescription": "Capture a screenshot of the installer window and return it as a base64-encoded PNG.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runInstaller"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_clickElement",
        "displayName": "Click UI Element",
        "modelDescription": "Click a UI element in the installer window by its element ID from the UI tree.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runInstaller"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            }
          },
          "required": [
            "pid",
            "elementId"
          ]
        }
      },
      {
        "name": "adagioAgent_typeText",
        "displayName": "Type Text into UI Element",
        "modelDescription": "Type text into a UI element in the installer window.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runInstaller"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            },
            "text": {
              "type": "string",
              "description": "Text to type into the element"
            }
          },
          "required": [
            "pid",
            "elementId",
            "text"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "20.11.5",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
