{
  "name": "adagio-agent-controller",
  "displayName": "Adagio Agent Controller",
  "description": "VS Code extension that connects Copilot to a Windows VM agent for automated executable testing",
  "version": "0.1.0",
  "publisher": "adagio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adagioAgent.runExecutable",
        "title": "Adagio Agent: Run Executable in VM"
      },
      {
        "command": "adagioAgent.getUiTree",
        "title": "Adagio Agent: Get UI Tree"
      },
      {
        "command": "adagioAgent.clickElement",
        "title": "Adagio Agent: Click Element"
      },
      {
        "command": "adagioAgent.getScreenshot",
        "title": "Adagio Agent: Get Screenshot"
      },
      {
        "command": "adagioAgent.typeText",
        "title": "Adagio Agent: Type Text"
      },
      {
        "command": "adagioAgent.copyFile",
        "title": "Adagio Agent: Copy File to Target"
      },
      {
        "command": "adagioAgent.getProcessStatus",
        "title": "Adagio Agent: Get Process Status"
      },
      {
        "command": "adagioAgent.waitForExit",
        "title": "Adagio Agent: Wait For Process Exit"
      },
      {
        "command": "adagioAgent.terminateProcess",
        "title": "Adagio Agent: Terminate Process"
      },
      {
        "command": "adagioAgent.readTextFile",
        "title": "Adagio Agent: Read Text File"
      },
      {
        "command": "adagioAgent.tailFile",
        "title": "Adagio Agent: Tail File"
      },
      {
        "command": "adagioAgent.getElementState",
        "title": "Adagio Agent: Get Element State"
      },
      {
        "command": "adagioAgent.waitForElement",
        "title": "Adagio Agent: Wait For Element"
      },
      {
        "command": "adagioAgent.setFocus",
        "title": "Adagio Agent: Set Focus"
      },
      {
        "command": "adagioAgent.sendKeys",
        "title": "Adagio Agent: Send Keys"
      },
      {
        "command": "adagioAgent.pressHotkey",
        "title": "Adagio Agent: Press Hotkey"
      }
    ],
    "configuration": {
      "title": "Adagio Agent",
      "properties": {
        "adagioAgent.vmAgentUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "Base URL of the VM agent (e.g. http://192.168.1.100:5000)"
        },
        "adagioAgent.allowedExecutablePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "C:\\Apps"
          ],
          "description": "Allowed executable directories (command whitelist)"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "adagioAgent_runExecutable",
        "displayName": "Run Executable in VM",
        "modelDescription": "Start an executable inside the Windows VM and return its process ID.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "Full path to the executable on the VM, e.g. C:\\Apps\\MyApp.exe"
            },
            "arguments": {
              "type": "string",
              "description": "Optional command-line arguments to pass to the executable"
            },
            "workingDirectory": {
              "type": "string",
              "description": "Optional working directory for the process"
            }
          },
          "required": [
            "command"
          ]
        }
      },
      {
        "name": "adagioAgent_getUiTree",
        "displayName": "Get UI Tree",
        "modelDescription": "Return the UI element hierarchy of the application window so Copilot can reason about which buttons or controls exist.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_getScreenshot",
        "displayName": "Get Screenshot",
        "modelDescription": "Capture a screenshot of the application window and return it as a base64-encoded PNG.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_clickElement",
        "displayName": "Click UI Element",
        "modelDescription": "Click a UI element in the application window by its element ID from the UI tree.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            }
          },
          "required": [
            "pid",
            "elementId"
          ]
        }
      },
      {
        "name": "adagioAgent_typeText",
        "displayName": "Type Text into UI Element",
        "modelDescription": "Type text into a UI element in the application window.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            },
            "text": {
              "type": "string",
              "description": "Text to type into the element"
            }
          },
          "required": [
            "pid",
            "elementId",
            "text"
          ]
        }
      },
      {
        "name": "adagioAgent_copyFile",
        "displayName": "Copy File to Target",
        "modelDescription": "Copy a local file to the machine-agent target system.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "localFilePath": {
              "type": "string",
              "description": "Absolute local path to the source file"
            },
            "destinationPath": {
              "type": "string",
              "description": "Absolute destination path on the target machine"
            },
            "overwriteIfExists": {
              "type": "boolean",
              "description": "When true, overwrite an existing destination file"
            }
          },
          "required": [
            "localFilePath",
            "destinationPath"
          ]
        }
      },
      {
        "name": "adagioAgent_getProcessStatus",
        "displayName": "Get Process Status",
        "modelDescription": "Get current state, timestamps, and optional exit code for a tracked process.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Tracked process ID"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_waitForExit",
        "displayName": "Wait For Process Exit",
        "modelDescription": "Wait for a tracked process to exit up to the specified timeout.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Tracked process ID"
            },
            "timeoutMilliseconds": {
              "type": "number",
              "description": "Maximum wait time in milliseconds"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_terminateProcess",
        "displayName": "Terminate Process",
        "modelDescription": "Terminate a tracked process on the target machine.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Tracked process ID"
            }
          },
          "required": [
            "pid"
          ]
        }
      },
      {
        "name": "adagioAgent_readTextFile",
        "displayName": "Read Text File",
        "modelDescription": "Read a UTF-8 text file from the target machine.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a target text file"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "adagioAgent_tailFile",
        "displayName": "Tail File",
        "modelDescription": "Read the last N lines of a UTF-8 text file from the target machine.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a target text file"
            },
            "lines": {
              "type": "number",
              "description": "Number of lines from the end of file"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "adagioAgent_getElementState",
        "displayName": "Get Element State",
        "modelDescription": "Retrieve the current state snapshot of a UI element.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            }
          },
          "required": [
            "pid",
            "elementId"
          ]
        }
      },
      {
        "name": "adagioAgent_waitForElement",
        "displayName": "Wait For Element",
        "modelDescription": "Wait until a UI element becomes available or timeout is reached.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            },
            "timeoutMilliseconds": {
              "type": "number",
              "description": "Maximum wait time in milliseconds"
            },
            "pollIntervalMilliseconds": {
              "type": "number",
              "description": "Polling interval in milliseconds"
            }
          },
          "required": [
            "pid",
            "elementId"
          ]
        }
      },
      {
        "name": "adagioAgent_setFocus",
        "displayName": "Set Focus",
        "modelDescription": "Focus a specific UI element in the application window.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "elementId": {
              "type": "string",
              "description": "Element ID from the UI tree"
            }
          },
          "required": [
            "pid",
            "elementId"
          ]
        }
      },
      {
        "name": "adagioAgent_sendKeys",
        "displayName": "Send Keys",
        "modelDescription": "Send keystrokes to the currently focused application window.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "text": {
              "type": "string",
              "description": "Keys or text to send"
            }
          },
          "required": [
            "pid",
            "text"
          ]
        }
      },
      {
        "name": "adagioAgent_pressHotkey",
        "displayName": "Press Hotkey",
        "modelDescription": "Press a key combination like Alt+N or Ctrl+Tab in the application window.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "number",
              "description": "Process ID returned by runExecutable"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Key names, for example [\"alt\", \"n\"]"
            }
          },
          "required": [
            "pid",
            "keys"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "20.11.5",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
