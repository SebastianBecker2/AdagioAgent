<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>AdagioMachineAgent.BootstrapperApplication</RootNamespace>
    <AssemblyName>AdagioMachineAgent.BA</AssemblyName>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Version alignment with machine-agent -->
    <Version>0.2.3</Version>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <FileVersion>0.2.3.0</FileVersion>
    
    <!-- Self-contained deployment for use in bundle -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Require administrator rights so the installer can write to Program Files
         and to the Windows Services registry hive. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON serialization for response file generation.
         8.0.5+ resolves known high-severity vuln GHSA-8g4q-xg66-9fp4. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.22621.0'">
    <Reference Include="System.Net.NetworkInformation" />
    <Reference Include="System.Net.Sockets" />
  </ItemGroup>

</Project>
