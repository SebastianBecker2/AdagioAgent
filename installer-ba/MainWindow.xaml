<Window x:Class="AdagioMachineAgent.BootstrapperApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adagio Machine Agent Installer"
        Width="720" Height="600"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AgentIcon.ico"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <!-- Content area for screens -->
        <ContentControl x:Name="ScreenContainer" Content="{Binding CurrentScreen}" />
        
        <!-- Navigation buttons -->
        <Grid VerticalAlignment="Bottom" Height="80" Background="#FFFFFF" >
            <Grid.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3" />
            </Grid.Effect>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" Click="PreviousButton_Click" 
                        Content="← Previous" Width="100" Height="40" Margin="0,0,10,0"
                        FontSize="12" Foreground="#0066CC" Background="White" BorderBrush="#CCCCCC" />
                <Button x:Name="NextButton" Click="NextButton_Click"
                        Content="Next →" Width="100" Height="40" Margin="0,0,10,0"
                        FontSize="12" Background="#0066CC" Foreground="White" />
                <Button x:Name="CancelButton" Click="CancelButton_Click"
                        Content="Cancel" Width="100" Height="40"
                        FontSize="12" Foreground="#666666" Background="White" BorderBrush="#CCCCCC" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
