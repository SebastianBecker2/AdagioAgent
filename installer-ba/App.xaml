<Application x:Class="AdagioMachineAgent.BootstrapperApplication.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Default theme colors -->
            <SolidColorBrush x:Key="PrimaryColor" Color="#0066CC" />
            <SolidColorBrush x:Key="SecondaryColor" Color="#F5F5F5" />
            <SolidColorBrush x:Key="AccentColor" Color="#FF6B00" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
