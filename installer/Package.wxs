<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v6 installer for Adagio Machine Agent.

  Installs the machine-agent as a Windows Service (AdagioMachineAgent) that
  starts automatically and listens on https://127.0.0.1:5443 by default.

  Upgrade behaviour: major upgrades replace earlier versions automatically.
  Uninstall: stops the service, removes it, and removes all installed files.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Adagio Machine Agent"
           Manufacturer="AdagioAgent"
           Version="$(var.AgentVersion)"
           UpgradeCode="{BA4F3D21-9E6B-4C7A-8F0E-2A1C5D8B7E3F}"
           Scope="perMachine">

    <!-- Replace any earlier version; block downgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Embed all files inside the single .msi cabinet. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Install to %ProgramFiles%\AdagioMachineAgent (64-bit path). -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AdagioMachineAgent" />
    </StandardDirectory>

    <Feature Id="Complete" Level="1">
      <!-- Main executable + service registration (defined below). -->
      <ComponentGroupRef Id="AgentService" />
      <!-- User-editable configuration file (preserved on upgrade). -->
      <ComponentGroupRef Id="AgentConfig" />
      <!-- Bootstrap provisioning assets (copied to INSTALLFOLDER). -->
      <ComponentGroupRef Id="BootstrapAssets" />
      <!-- All other published files (harvested automatically). -->
      <ComponentGroupRef Id="ApplicationFiles" />
    </Feature>

    <!--
      First-install bootstrap flow:
      1) MSI installs files, including bootstrap-agent.ps1.
      2) Custom action runs bootstrap script elevated to generate cert + API key
         and write startup-critical values into installed appsettings.json.
      3) ServiceControl Start="install" then verifies the configured service can
         actually start. If startup still fails, MSI fails with 1920.
    -->
    <CustomAction Id="RunBootstrapAgentScript"
                  Directory="INSTALLFOLDER"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]bootstrap-agent.ps1&quot; -WriteToAppSettings -SuppressSecretOutput -LogPath &quot;C:\ProgramData\AdagioMachineAgent\bootstrap.log&quot;" />

    <InstallExecuteSequence>
      <Custom Action="RunBootstrapAgentScript"
              After="InstallFiles"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <!--
      Service component: installs AdagioMachineAgent.exe and registers the
      Windows Service.  The service is started on install and stopped/removed
      on uninstall.

      Note on interactive desktop access
      ───────────────────────────────────
      Windows services run in Session 0 (isolated from the interactive desktop).
      FlaUI/UIA3 UI automation therefore requires the service to run under a
      user account that owns an interactive session rather than LocalSystem.
      After installation an administrator can change the "Log on as" account
      in services.msc or via:

          sc.exe config AdagioMachineAgent obj= ".\LocalUser"   password= "***"
          sc.exe config AdagioMachineAgent obj= "DOMAIN\User"   password= "***"
    -->
    <ComponentGroup Id="AgentService" Directory="INSTALLFOLDER">
      <Component>
        <File Id="AdagioMachineAgentExe" Source="$(var.PublishDir)AdagioMachineAgent.exe" KeyPath="yes" />
        <ServiceInstall Id="ServiceInstall"
                        Name="AdagioMachineAgent"
                        DisplayName="Adagio Machine Agent"
                        Description="REST API for process control and UI automation (HTTPS loopback by default)."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService" />
        <ServiceControl Id="ServiceControl"
                        Name="AdagioMachineAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="BootstrapAssets" Directory="INSTALLFOLDER">
      <Component>
        <File Id="BootstrapAgentScript" Source="$(sys.SOURCEFILEDIR)..\scripts\bootstrap-agent.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AgentConfig" Directory="INSTALLFOLDER">
      <Component NeverOverwrite="yes">
        <File Id="AgentAppSettings"
              Source="$(var.PublishDir)appsettings.json"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>

</Wix>
