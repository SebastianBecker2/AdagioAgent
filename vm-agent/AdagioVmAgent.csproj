<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>AdagioVmAgent</AssemblyName>
    <RootNamespace>AdagioVmAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Allow cross-compilation from non-Windows hosts (e.g. Linux CI).
      The agent itself is only designed to run on Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!--
      FlaUI is Windows-only and requires the target to run on Windows.
      The package references are included here so the project compiles; the
      runtime guard in UiAutomationService ensures a clear error when the agent
      is accidentally run on a non-Windows host.
    -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>
