{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "127.0.0.1;localhost",
  "Urls": "https://127.0.0.1:5443",
  "SecurityOptions": {
    "RequireHttps": true,
    "HttpsCertificatePath": "C:\\ProgramData\\AdagioMachineAgent\\tls\\agent.pfx",
    "HttpsCertificatePassword": "CHANGE_ME_CERT_PASSWORD",
    "AllowDevelopmentCertificateFallback": false,
    "RequireApiKey": true,
    "ApiKeyHeaderName": "X-API-Key",
    "ApiKey": "CHANGE_ME"
  },
  "AgentOptions": {
    "AllowedExecutablePaths": [
      "C:\\Apps",
      "/usr/local/bin"
    ],
    "AllowedWritablePaths": [
      "C:\\Apps",
      "/tmp"
    ],
    "AllowedReadablePaths": [
      "C:\\Apps",
      "/var/log",
      "/tmp"
    ],
    "ProcessTimeoutSeconds": 300,
    "MaxConcurrentProcesses": 5,
    "MaxConcurrentSessions": 5,
    "SessionIdleTimeoutSeconds": 3600
  }
}
